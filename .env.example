# Get a key at https://console.deepgram.com/ (needs at least "Member" permissions
# so it can mint short-lived tokens via /v1/auth/grant).
DEEPGRAM_API_KEY=your-deepgram-api-key-here

# Used by the per-turn scoring judge (a small Anthropic/Claude call the brain
# makes itself, separate from the in-pipeline agent LLM). Without it the game
# still runs — every turn just scores the minimum (100) instead of being graded
# 100/500/1000.
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional: which heists are enabled at this event (comma-separated ids).
# Omit for all four. Example: only the club + pizza:
# VOICE_HEIST_AVAILABLE=list,order,receptionist,refund

# Optional: a special login code with UNLIMITED turns and replays, for testing.
# Sign in with this code to bypass the 5-turn cap and the one-play-per-day
# limit; these plays never appear on the leaderboard. Unset to disable.
# VH_TEST_CODE=TESTME

# Optional: port for the token/static server (defaults to 8000 for the Python brain)
PORT=8000

# --- Authentication (v2) ---------------------------------------------------
# Random 32+ byte secret used to sign auth cookies. REQUIRED in prod (Fly secret).
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
AUTH_SIGNING_SECRET=
# Cookie Secure attribute: off over http://localhost (dev), on in prod (https).
COOKIE_SECURE=false
# Game timezone — drives the daily "one play per scenario per day" reset and
# what counts as "today" on the leaderboard, everywhere in the world.
EVENT_TZ=America/Los_Angeles
# SQLite path. Dev defaults to ./voice-heist.db; prod uses the Fly volume.
# VH_DB_PATH=/data/voice-heist.db

# --- Open-web guardrails -----------------------------------------------------
# Per-IP budget for minting Deepgram tokens (the expensive faucet). Legit play
# mints ~4 per heist; the defaults allow a generous session and stop farmers.
# TOKEN_RATE_BURST=40
# TOKEN_RATE_WINDOW=600

# --- OAuth / OIDC (Auth0, swappable) ---------------------------------------
# Leave unset to run without OAuth (Quick Play / staff / code sign-in still work).
# Provider-neutral on purpose: switching providers is config, not code.
# OIDC_ISSUER=https://YOUR_TENANT.us.auth0.com/
# OIDC_CLIENT_ID=your-client-id
# OIDC_CLIENT_SECRET=your-client-secret          (Fly secret in prod)
# OIDC_REDIRECT_URI=http://localhost:8000/api/auth/oidc/callback
# Provider label stored on each player (defaults to "auth0"). Set when swapping IdPs.
# OIDC_PROVIDER=auth0

# --- Admin portal (/admin) -------------------------------------------------
# Reuses the same Auth0 app; add this 2nd callback to Auth0 Allowed Callback URLs.
# OIDC_ADMIN_REDIRECT_URI=http://localhost:8000/api/admin/oidc/callback
# Only verified emails on this domain may access /admin (default deepgram.com).
# ADMIN_EMAIL_DOMAIN=deepgram.com
# Admin session lifetime in seconds (default 8h).
# ADMIN_TOKEN_TTL=28800

# NOTE: VOICE_HEIST_AVAILABLE above is only a first-boot SEED default. After
# first start, the /admin portal is the source of truth for availability.

